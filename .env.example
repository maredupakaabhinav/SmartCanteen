# ---------------------------------------------------------------------------
# Smart Canteen environment variables
# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Browser (public). Safe to expose: access is enforced by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional: shown in the footer if the canteen has no contact email set.
VITE_SUPPORT_EMAIL=

# --- Server only (used by /api functions). NEVER prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay — use TEST keys (rzp_test_...) until you are ready to go live.
# When both keys are set, real Razorpay checkout is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Demo mode: only used when the Razorpay keys above are empty. Orders are
# marked "simulated", clearly labelled in the UI and excluded from revenue.
# Leave empty in production so payments are simply disabled if misconfigured.
PAYMENT_MODE=
